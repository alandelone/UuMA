# Secret values belong in individual mode-0600 token files, never in Git.
UUMA_HOST=127.0.0.1
UUMA_NODE_ID=server
UUMA_PORT=8765
UUMA_DATA_DIR=/home/alandelone/.local/share/uuma/data
UUMA_KNOWLEDGE_DATA_DIR=/home/alandelone/.local/share/uuma/data
UUMA_HONC_DATA_DIR=/home/alandelone/.local/share/uuma/data/honc
UUMA_CONTROL_URL=http://127.0.0.1:8765
UUMA_REQUIRE_REMOTE_CONTROL=1
UUMA_IDENTITY_TOKEN_DIR=/home/alandelone/.config/uuma/identities
UUMA_BGE_DEVICE=cpu
LAB_DATABASE_PATH=/home/alandelone/.local/share/uuma/data/forge-lab-bot/lab.db
# Per-process environment must also set UUMA_AGENT_ID and UUMA_IDENTITY_TOKEN_FILE.
# Only workstation Control/Knowledge proxies set UUMA_REMOTE_MCP_URL.
