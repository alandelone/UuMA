+        row["baseline_version_id"] = "another-baseline"
+    elif invalid == "wrong_pdf":
+        row["final_pdf_sha256"] = "f" * 64
+    elif invalid == "wrong_text":
+        request["claims"][0]["text"] = "Not the saved reply"
+    else:
+        request["claims"][0]["evidence_ids"] *= 2
