+/** JSON workspace requests share the page origin; fixed files keep their own route. */
+export async function serveStudioRequest(
+  request: Request,
+  segments: string[],
+  configuredBase: string,
+  fetchUpstream: typeof fetch = fetch,
+): Promise<Response> {
+  const error = (status: number, detail: string) => Response.json({ detail }, {
+    status, headers: { 'Cache-Control': 'no-store', 'X-Content-Type-Options': 'nosniff' },
+  });
+  const method = request.method;
+  if (!['GET', 'POST', 'PUT', 'PATCH', 'DELETE'].includes(method)) return error(405, '此工作区请求方式不可用。');
+  const origin = request.headers.get('Origin');
+  const sameOrigin = new URL(request.url).origin;
+  if ((origin && origin !== sameOrigin) ||
+      (!origin && method !== 'GET') || request.headers.get('Sec-Fetch-Site') === 'cross-site') {
+    return error(403, '请从本写作工作区执行此操作。');
+  }
+  const roots = new Set(['tracks', 'manuscripts', 'comments', 'review-rounds', 'review-comments', 'jobs', 'findings', 'research']);
+  if (!segments.length || !roots.has(segments[0]) ||
+      segments.some((part) => !/^[a-zA-Z0-9_-]{1,128}$/.test(part)) ||
+      (segments[0] === 'research' && segments[1] !== 'discussion') ||
+      segments.some((part) => ['download', 'files', 'content', 'pdf', 'materials'].includes(part))) {
+    return error(404, '工作区数据入口不存在。');
+  }
+  let base: URL;
+  try { base = new URL(configuredBase); }
+  catch { return error(503, '本机写作服务地址无效。'); }
+  if (base.protocol !== 'http:' || !['127.0.0.1', 'localhost'].includes(base.hostname) ||
+      base.username || base.password || base.search || base.hash ||
+      base.pathname.replace(/\/$/, '') !== '/api') return error(503, '本机写作服务地址无效。');
+  const headers = new Headers();
+  for (const name of ['Content-Type', 'If-Match', 'X-Operation-Id']) {
+    const value = request.headers.get(name);
+    if (value) headers.set(name, value);
+  }
+  const init: RequestInit & { duplex?: 'half' } = {
+    method, headers, cache: 'no-store', redirect: 'error',
+    signal: AbortSignal.timeout(60_000),
+  };
+  if (method !== 'GET' && request.body) {
+    init.body = request.body;
+    init.duplex = 'half';
+  }
+  try {
+    const upstream = await fetchUpstream(
+      `${base.href.replace(/\/$/, '')}/${segments.join('/')}${new URL(request.url).search}`, init,
+    );
+    if (upstream.status < 200 || (upstream.status >= 300 && upstream.status < 400) ||
+        !/^application\/json(?:\s*;|$)/i.test(upstream.headers.get('Content-Type') || '')) {
+      await upstream.body?.cancel();
+      return error(502, '本机服务未返回可读取的结果。请重新读取状态后再决定是否重试。');
+    }
+    return new Response(upstream.body, { status: upstream.status, headers: {
+      'Content-Type': upstream.headers.get('Content-Type')!,
+      'Cache-Control': 'no-store', 'X-Content-Type-Options': 'nosniff',
+    } });
+  } catch {
+    return error(502, '本机服务连接中断。请重新读取状态；刚才的操作可能已经保存，请勿重复提交。');
+  }
+}
