+      assert.equal(received.length, 1); assert.equal(received[0].method, 'PUT'); assert.equal(received[0].body.toString(), body);
+      assert.equal(received[0].url, '/api/manuscripts/ms/document?scope=own&q=%E4%B8%AD%20%26%20x');
