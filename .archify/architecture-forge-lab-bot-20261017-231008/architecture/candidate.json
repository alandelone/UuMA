  "cards": [
    {
      "dot": "cyan",
      "title": "如何看到 Forge",
      "items": [
        "启动 Observatory 后打开 http://127.0.0.1:8790/。",
        "点击 Forge 卡片打开专用工作区；放大开关展开三大板块。",
        "项目 → BOM / 图纸 / 文档预览；采购 → 平台与待审筛选；日志 → 系统筛选与 Notion 原页。"
      ]
    },
    {
      "dot": "violet",
      "title": "其他界面",
      "items": [
        "Hermes 对话：调用领域工具并接收结果。",
        "Excel 四表协议：说明与摘要、订单待核对、比价清单、收货确认。",
        "labbot-commerce 扩展已迁出本仓库，只能验证 NativeHost 接口。",
        "ChatGPT Bridge 控制台管理路由与请求；Forge 仅配置 search。"
      ]
    },
    {
      "dot": "rose",
      "title": "权威与读法",
      "items": [
        "lab.db 是实验室业务；uuma.db 是控制状态；wisdom.db 是知识域，彼此不跨库 JOIN。",
        "工程经验按策略保持候选；设计反馈写本地提案，不代表设计已被采用。",
        "本图是源码结构，未验证本机服务、外部 eSchematic 或扩展正在运行。"
      ]
    },
    {
      "dot": "amber",
      "title": "显示值的限制",
      "items": [
        "UI 与适配器有历史数量、阶段百分比和状态兜底；卡片不等于实时进程证据。",
        "Observatory 对业务数据只读；自身活动索引另存 observatory.db。"
      ]
    }
  ]
