  "cards": [
    {
      "dot": "cyan",
      "title": "同步实际行为",
      "items": [
        "GET /agents 与 SSE 连接会各自读取一份工作区快照，时序只展开首次读取。",
        "SSE 的 activity 更新活动流；源码没有持续广播完整 Forge 工作区。",
        "SSE 断开后 5 秒尝试重连；卡片兜底轮询的实际间隔是 10 秒，界面文字写的是 5s。"
      ]
    },
    {
      "dot": "rose",
      "title": "只读与限制",
      "items": [
        "所有 API 经过本机环回或查看凭据检查。",
        "业务数据库以 mode=ro 打开；文档仅允许规定扩展名并拒绝目录穿越。",
        "纵向间距仅表示调用先后，不表示测量耗时。"
      ]
    }
  ]
