{
  "manifest_version": 3,
  "name": "UuMA ChatGPT Bridge",
  "version": "0.1.4",
  "description": "Connects an already signed-in ChatGPT tab to the local UuMA bridge without reading cookies.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {"matches": ["http://127.0.0.1:8787/*", "http://localhost:8787/*"], "js": ["dashboard.js"]},
    {"matches": ["https://chatgpt.com/*"], "js": ["chatgpt.js"]}
  ],
  "action": {"default_title": "UuMA ChatGPT Bridge"}
}
